<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: your HDHomeRun + api.hdhomerun.com (guide), and optionally your Plex server + plex.tv (sign-in). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: hand a newer APK of this same app to Android's installer (you confirm on screen). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Full Guide "Remind me": an alarm a minute before the show starts (exact, so it's on time). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets the launcher see the apps allowed in this profile. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- Other home screens (launchers), for Settings › System › Home screen app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.silicondust.view" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Android TV / Shield app row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Phones and tablets: an icon in the app drawer, and "Open" after installing -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen (Home button). A separate entry so Settings › System › Home screen app can
             switch it off to hand Home back to another launcher; the app itself stays in the app row. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />

        <activity
            android:name=".CamerasActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />
        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AppsActivity" android:exported="false" />
        <activity
            android:name=".GridActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <!-- Reminder pop-up: its own task, so it floats over another app without bringing the home screen up. -->
        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:theme="@style/Theme.Reminder"
            android:launchMode="singleTask"
            android:taskAffinity=".reminder"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <receiver android:name=".UpdateReceiver" android:exported="false" />
    </application>
</manifest>
